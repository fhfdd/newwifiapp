<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F5F5">


    <FrameLayout
        android:id="@+id/fl_top_display"
        android:layout_width="match_parent"
        android:layout_height="120dp">
        <!-- 呼吸灯光晕覆盖层（自定义View） -->
        <com.example.indoornavblind.ui.view.GlowView
            android:layout_margin="10dp"
            android:id="@+id/view_glow_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>
        <!-- 顶部显示区 -->
        <TextView
            android:layout_margin="10dp"
            android:id="@+id/tv_top_display"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:background="@drawable/rounded_bg2"
            android:padding="20dp"
            android:text="欢迎使用盲人导航"
            android:textSize="24sp"
            android:textColor="#000000"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="状态显示区，点击重播语音"/>

    </FrameLayout>

    <!-- 语音输入框 -->
    <EditText
        android:id="@+id/et_voice_simulate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_below="@id/fl_top_display"
        android:layout_marginTop="20dp"
        android:hint="输入目的地"
        android:textSize="20sp"
        android:padding="15dp"
        android:background="@drawable/rounded_bg"
        android:imeOptions="actionDone"
        android:visibility="gone"
        android:contentDescription="输入目的地"/>

    <!-- 3按钮网格布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/et_voice_simulate"
        android:layout_marginTop="20dp"
        android:layout_above="@+id/bottom_spacer"
        android:orientation="vertical">

        <!-- 第一行：定位导航 + 语音助手 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 定位/导航按钮（合并） -->
            <Button
                android:id="@+id/btn_locate_nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:text="@string/locate_nav"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:contentDescription="定位和导航按钮。未定位时点击定位，定位后输入目的地再点击开始导航"/>

            <!-- 语音助手按钮（按住说话） -->
            <Button
                android:id="@+id/btn_voice_assistant"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:text="@string/voice_assistant"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/button_secondary"
                android:backgroundTint="@null"
                android:textColor="#FFFFFF"
                android:contentDescription="语音助手按钮，按住说话，松开结束"/>
        </LinearLayout>

        <!-- 第二行：紧急求助 + 我的设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- 紧急求助按钮 -->
            <Button
                android:id="@+id/btn_emergency"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:text="@string/help"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/button_danger"
                android:textColor="#FFFFFF"
                android:contentDescription="紧急求助按钮"/>

            <!-- 我的设置按钮 -->
            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:text="@string/settings"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/button_settings"
                android:textColor="#FFFFFF"
                android:contentDescription="设置按钮"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_alignParentBottom="true"/>

    <!-- 设置全屏浮层（无按钮，全屏手势操作） -->
    <FrameLayout
        android:id="@+id/settings_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- 设置内容区域 -->
        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="40dp"/>

            <!-- 语速显示 -->
            <TextView
                android:id="@+id/tv_speed_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="语速：1.0倍"
                android:textSize="36sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="30dp"
                android:layout_marginBottom="20dp"/>

            <!-- 语言显示 -->
            <TextView
                android:id="@+id/tv_language_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="语言：中文"
                android:textSize="36sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="30dp"
                android:layout_marginBottom="20dp"/>

            <!-- 播报间隔显示 -->
            <TextView
                android:id="@+id/tv_pace_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="播报间隔：3秒"
                android:textSize="36sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="30dp"
                android:layout_marginBottom="40dp"/>

            <!-- ...步数  ... -->

            <TextView
                android:id="@+id/tv_unit_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="距离单位：步数"
                android:textSize="28sp"
                android:gravity="center"
                android:padding="24dp"
                android:background="#330000FF" />

            <!-- 操作提示 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="上下滑动：调节语速\n左右滑动：切换语言\n双击屏幕：退出设置"
                android:textSize="20sp"
                android:textColor="#CCCCCC"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>
    </FrameLayout>


</RelativeLayout>
