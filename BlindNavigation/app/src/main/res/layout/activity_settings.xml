<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_mode"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Speech Speed -->
        <TextView
            android:id="@+id/speechSpeedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speech_speed_label"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speechSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0×"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/speechSpeedSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:layout_marginBottom="24dp" />

        <!-- Language -->
        <TextView
            android:id="@+id/languageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_label"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:popupBackground="#333333"
            android:layout_marginTop="8dp"
            android:entries="@array/languages"
            android:layout_marginBottom="24dp" />

        <!-- Navigation Unit -->
        <TextView
            android:id="@+id/navigationUnitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/navigation_unit_label"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/navigationUnitGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp">

            <RadioButton
                android:id="@+id/unitMeters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_meters"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <RadioButton
                android:id="@+id/unitSteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unit_steps"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="40dp" />
        </RadioGroup>

        <!-- Gesture Info (Optional hint area) -->
        <FrameLayout
            android:id="@+id/gestureArea"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#222222"
            android:gravity="center"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/gestureText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gesture_instruction"
                android:textColor="#AAAAAA"
                android:textSize="18sp" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>